# ===== Dùng cho Docker Compose (và là nguồn chung cho .env) =====
DB_NAME=smartcrm
DB_USER=smartcrm
# Không dùng các ký tự @ : / # ? trong mật khẩu (sẽ làm hỏng chuỗi kết nối)
DB_PASSWORD=doi_mat_khau_nay
DB_HOST_PORT=5433
API_PORT=3000
WEB_PORT=5173
# Địa chỉ trình duyệt dùng để mở giao diện; phải khớp WEB_PORT
CORS_ORIGIN=http://localhost:5173
# Địa chỉ API mà TRÌNH DUYỆT gọi (được ghi vào bản dựng giao diện)
PUBLIC_API_URL=http://localhost:3000
LOG_LEVEL=info
# Thư mục dữ liệu nạp vào (mặc định bộ mẫu nhỏ trong repo)
# DATASET_HOST_DIR=./data/raw

# ===== Chỉ dùng khi chạy trực tiếp trên máy (npm run dev), không qua Docker =====
PORT=3000
DATABASE_URL=postgresql://smartcrm:doi_mat_khau_nay@localhost:5432/smartcrm
# DATASET_DIR=data/raw

# ===== Đăng nhập / đăng ký (BẮT BUỘC) =====
# Khoá ký mã phiên, tối thiểu 16 ký tự. Đổi sang chuỗi ngẫu nhiên của riêng em, KHÔNG dùng lại giá trị mẫu khi triển khai thật.
JWT_SECRET=doi_khoa_bi_mat_nay_toi_thieu_16_ky_tu
# Mã đăng ký cho vai trò quyền cao (người dùng phải nhập đúng mới tự đăng ký được).
# Để trống = không ai tự đăng ký được vai trò đó. Vai trò Nhân viên tiếp nhận đăng ký tự do.
REGISTER_CODE_KY_THUAT_VIEN=KTV-2026
REGISTER_CODE_QUAN_LY=QL-2026
# true = trang đăng nhập hiện khung "Tài khoản dùng thử" (chỉ nên true khi chạy thử/chấm bài)
SHOW_DEMO_ACCOUNTS=true
