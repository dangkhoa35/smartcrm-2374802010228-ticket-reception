        <mxCell id="1abYOITR93vRSWB3bo53-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#333333;fillColor=#ffffff;spacing=0;labelBorderColor=default;" value="&lt;div style=&quot;background:#b3d4f5;text-align:center;font-weight:bold;padding:4px&quot;&gt;ticket&lt;/div&gt;&lt;table width=&quot;100%&quot; cellpadding=&quot;1&quot; style=&quot;font-size:11px&quot;&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ticket_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BIGSERIAL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;td&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ticket_code&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(20)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;customer_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BIGINT  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;device_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BIGINT  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;category_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;INT  (NULL được)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f5f5f5&quot;&gt;&lt;td&gt;&lt;b&gt;ref&lt;/b&gt;&lt;/td&gt;&lt;td&gt;center_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BIGINT  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;issue_desc&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;TEXT  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;priority&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(10)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&g