        <mxCell id="1abYOITR93vRSWB3bo53-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#333333;fillColor=#ffffff;spacing=0;labelBorderColor=default;fontColor=default;" value="&lt;div style=&quot;background:#b3d4f5;text-align:center;font-weight:bold;padding:4px&quot;&gt;device&lt;/div&gt;&lt;table width=&quot;100%&quot; cellpadding=&quot;1&quot; style=&quot;font-size:11px&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;device_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BIGSERIAL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;customer_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BIGINT  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;td&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;serial_no&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(50)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;product_name&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(120)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;purchase_date&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;DATE  (NULL được)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;warranty_months&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;SMALLINT  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
