        <mxCell id="1abYOITR93vRSWB3bo53-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;textShadow=0;labelBorderColor=default;autosizeText=0;fontSize=8;strokeWidth=1;" value="&lt;div style=&quot;background:#b3d4f5;text-align:center;font-weight:bold;padding:4px&quot;&gt;customer&lt;/div&gt;&lt;table width=&quot;100%&quot; cellpadding=&quot;1&quot; style=&quot;font-size:11px&quot;&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;customer_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BIGSERIAL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;td&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;phone&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(20)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;full_name&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(120)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;email&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;address&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;TIMESTAMPTZ  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;is_active&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BOOLEAN  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
