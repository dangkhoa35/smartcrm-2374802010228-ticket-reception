        <mxCell id="1abYOITR93vRSWB3bo53-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#333333;fillColor=#ffffff;spacing=0;labelBorderColor=default;" value="&lt;div style=&quot;background:#b3d4f5;text-align:center;font-weight:bold;padding:4px&quot;&gt;issue_category&lt;/div&gt;&lt;table width=&quot;100%&quot; cellpadding=&quot;1&quot; style=&quot;font-size:11px&quot;&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;category_id&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;SERIAL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;td&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;category_name&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(60)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;default_priority&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;VARCHAR(10)  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;is_active&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;BOOLEAN  NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
